{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "UseSecretManager": false,
  "JwtOptions": {
    "Lifetime": 30,
    "SecretKey": "HL#6j=4;5H{5qZ#M=6J!1[W<YvWdbzEif|M]:ZB<6<{ap^K!@Tg{];OD0E",
    "ValidAudience": "storeApp",
    "ValidIssuer": "identity",
    "ValidateAudience": true,
    "ValidateIssuer": true,
    "ValidateLifetime": true
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "ApiGateway",
        "Uri": "/health"
      }
    ],
    "EvaluationTimeOnSeconds": 10,
    "MaximumHistoryEntriesPerEndpoint": 60,
    "StorageMode": "InMemory"
  },
  "ServiceRegistration": {
    "ServiceDiscoveryAddress": "http://localhost:8500"
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "JaegerSettings": {
    "Host": "localhost",
    "Port": 6831
  }
}
